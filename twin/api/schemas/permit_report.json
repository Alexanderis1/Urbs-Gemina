{
  "name": "permit_report",
  "description": "Cited permit-context report: location, 300 m context, field estimate, legal references, provenance.",
  "input_schema": {
    "$defs": {
      "Antenna": {
        "additionalProperties": false,
        "properties": {
          "lon": {
            "maximum": 13.1,
            "minimum": 12.0,
            "title": "Lon",
            "type": "number"
          },
          "lat": {
            "maximum": 42.4,
            "minimum": 41.4,
            "title": "Lat",
            "type": "number"
          },
          "height_m": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 300,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Height above ground; default from config",
            "title": "Height M"
          },
          "eirp_w": {
            "anyOf": [
              {
                "maximum": 100000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Total EIRP in watts",
            "title": "Eirp W"
          },
          "band_mhz": {
            "anyOf": [
              {
                "enum": [
                  800,
                  1800,
                  2100,
                  3500
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Used for a typical EIRP when eirp_w is missing (assumption)",
            "title": "Band Mhz"
          }
        },
        "required": [
          "lon",
          "lat"
        ],
        "title": "Antenna",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Cited permit-context report: location, 300 m context, field estimate, legal references, provenance.",
    "properties": {
      "place": {
        "anyOf": [
          {
            "maxLength": 300,
            "minLength": 2,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Place"
      },
      "point": {
        "anyOf": [
          {
            "description": "[lon, lat] WGS84",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Point"
      },
      "proposed_antennas": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/Antenna"
            },
            "maxItems": 20,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Proposed Antennas"
      },
      "radius_m": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "maximum": 2000,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Radius M"
      }
    },
    "title": "PermitReportIn",
    "type": "object"
  },
  "output_schema": {
    "$ref": "envelope.json"
  },
  "http": {
    "method": "POST",
    "path": "/tools/permit_report"
  },
  "owner": "WS4"
}
