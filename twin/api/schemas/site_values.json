{
  "name": "site_values",
  "description": "A belief layer read at each sensitive site (schools, hospitals...) in the area, riskiest first.",
  "input_schema": {
    "additionalProperties": false,
    "description": "A belief layer read at each sensitive site (schools, hospitals...) in the area, riskiest first.",
    "properties": {
      "layer": {
        "description": "belief layer, e.g. emf, air_no2, air_pm10, rain",
        "maxLength": 80,
        "minLength": 1,
        "title": "Layer",
        "type": "string"
      },
      "area": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": true,
            "type": "object"
          }
        ],
        "default": "city",
        "description": "Operating area: 'city', 'municipio:<n>' (1-15), 'zone:<CODE>' (urban-zone code, upper case) or a GeoJSON Polygon/MultiPolygon in WGS84 [lon, lat].",
        "title": "Area"
      },
      "threshold": {
        "anyOf": [
          {
            "maxLength": 60,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "optional named legal threshold, same names as the exposure tool",
        "title": "Threshold"
      },
      "categories": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "education",
                "health",
                "green",
                "government",
                "critical_infrastructure",
                "hazardous_industry"
              ],
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Categories"
      },
      "limit": {
        "default": 50,
        "maximum": 500,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "time": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "ISO 8601; default now",
        "title": "Time"
      }
    },
    "required": [
      "layer"
    ],
    "title": "SiteValuesIn",
    "type": "object"
  },
  "output_schema": {
    "$ref": "envelope.json"
  },
  "http": {
    "method": "POST",
    "path": "/tools/site_values"
  },
  "owner": "WS5"
}
