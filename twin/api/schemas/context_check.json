{
  "name": "context_check",
  "description": "List sensitive sites and constraints within a radius (default 300 m). Distance is context, not a ban.",
  "input_schema": {
    "additionalProperties": false,
    "description": "List sensitive sites and constraints within a radius (default 300 m). Distance is context, not a ban.",
    "properties": {
      "point": {
        "description": "[lon, lat] WGS84",
        "items": {
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "title": "Point",
        "type": "array"
      },
      "radius_m": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "maximum": 2000,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Radius M"
      }
    },
    "required": [
      "point"
    ],
    "title": "ContextCheckIn",
    "type": "object"
  },
  "output_schema": {
    "$ref": "envelope.json"
  },
  "http": {
    "method": "POST",
    "path": "/tools/context_check"
  },
  "owner": "WS4"
}
