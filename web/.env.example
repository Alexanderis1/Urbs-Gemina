# Copy to .env.local. Leave empty to run on built-in sample data (everything shows as SIMULATED).
# Base URL of the tool proxy (a Supabase/Lovable edge function that holds the keys and forwards to the tool API).
VITE_TOOL_PROXY_URL=
# PMTiles archive of the G0 block model (WS2). Empty = the public R2 copy (https://pub-92f3b81279724b93b2c580e6b7c1cb37.r2.dev/buildings.pmtiles).
# "osm" = the base map's OpenStreetMap buildings instead. Local file: copy it to public/ and use /buildings.pmtiles.
VITE_BUILDINGS_PMTILES_URL=
# Credit line for those tiles (default: the GlobalBuildingAtlas variant's attribution).
VITE_BUILDINGS_ATTRIBUTION=
# Base map style (no key needed).
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
