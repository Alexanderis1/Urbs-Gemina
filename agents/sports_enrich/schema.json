{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "sourced": {
      "type": "object",
      "properties": {
        "value": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "quote": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["value", "source_url", "confidence"]
    }
  },
  "type": "object",
  "properties": {
    "facilities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "facility_id": {"type": "string", "description": "Copy from the input row unchanged"},
          "disciplines": {"type": "array", "items": {"$ref": "#/definitions/sourced"}},
          "hours": {"anyOf": [{"$ref": "#/definitions/sourced"}, {"type": "null"}]},
          "accessibility": {"anyOf": [{"$ref": "#/definitions/sourced"}, {"type": "null"}]},
          "contact": {
            "anyOf": [{"type": "null"}, {
              "type": "object",
              "properties": {
                "emails": {"type": "array", "items": {"type": "string"}},
                "phones": {"type": "array", "items": {"type": "string"}},
                "website": {"type": ["string", "null"]},
                "source_url": {"type": "string", "format": "uri"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "required": ["source_url", "confidence"]
            }]
          },
          "appears_closed": {"type": ["boolean", "null"]}
        },
        "required": ["facility_id"]
      }
    }
  },
  "required": ["facilities"]
}
