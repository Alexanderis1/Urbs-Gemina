{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "address": {"type": ["string", "null"]},
          "municipio": {"type": "string", "description": "Roman numeral I-XV"},
          "kind": {"type": "string", "enum": ["school_gym", "sports_centre", "pool", "pitch", "gym", "other"]},
          "disciplines": {"type": "array", "items": {"type": "string"}},
          "open_to_public": {"type": ["boolean", "null"]},
          "appears_closed": {"type": ["boolean", "null"]},
          "source_url": {"type": "string", "format": "uri"},
          "quote": {"type": "string", "description": "Short verbatim text from the source supporting the record"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["name", "municipio", "source_url", "confidence"]
      }
    }
  },
  "required": ["candidates"]
}
